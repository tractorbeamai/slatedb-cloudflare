--- a/src/runtime.rs	1969-12-31 18:00:00
+++ b/src/runtime.rs	2026-08-17 18:35:20
@@ -0,0 +1,78 @@
+#[cfg(not(target_arch = "wasm32"))]
+pub(crate) use tokio::runtime::Handle;
+#[cfg(not(target_arch = "wasm32"))]
+pub(crate) use tokio_util::task::AbortOnDropHandle;
+
+#[cfg(target_arch = "wasm32")]
+#[derive(Clone, Debug, Default)]
+pub(crate) struct Handle;
+
+#[cfg(target_arch = "wasm32")]
+impl Handle {
+    pub(crate) fn current() -> Self {
+        Self
+    }
+
+    pub(crate) fn spawn<F>(&self, future: F) -> tokio::task::JoinHandle<F::Output>
+    where
+        F: std::future::Future + 'static,
+        F::Output: 'static,
+    {
+        tokio::spawn(future)
+    }
+}
+
+#[cfg(target_arch = "wasm32")]
+pub(crate) struct AbortOnDropHandle<T> {
+    handle: Option<tokio::task::JoinHandle<T>>,
+}
+
+#[cfg(target_arch = "wasm32")]
+impl<T> AbortOnDropHandle<T> {
+    pub(crate) fn new(handle: tokio::task::JoinHandle<T>) -> Self {
+        Self {
+            handle: Some(handle),
+        }
+    }
+
+    pub(crate) fn is_finished(&self) -> bool {
+        self.handle
+            .as_ref()
+            .is_none_or(tokio::task::JoinHandle::is_finished)
+    }
+
+    pub(crate) fn abort(&self) {
+        if let Some(handle) = &self.handle {
+            handle.abort();
+        }
+    }
+}
+
+#[cfg(target_arch = "wasm32")]
+impl<T> Drop for AbortOnDropHandle<T> {
+    fn drop(&mut self) {
+        if let Some(handle) = &self.handle {
+            handle.abort();
+        }
+    }
+}
+
+#[cfg(target_arch = "wasm32")]
+impl<T> std::future::Future for AbortOnDropHandle<T> {
+    type Output = Result<T, tokio::task::JoinError>;
+
+    fn poll(
+        mut self: std::pin::Pin<&mut Self>,
+        cx: &mut std::task::Context<'_>,
+    ) -> std::task::Poll<Self::Output> {
+        let handle = self
+            .handle
+            .as_mut()
+            .expect("polled AbortOnDropHandle after completion");
+        let result = std::pin::Pin::new(handle).poll(cx);
+        if result.is_ready() {
+            self.handle.take();
+        }
+        result
+    }
+}
